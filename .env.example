# Copy this file to .env before running docker compose.

API_KEY=change-me
OPENCODE_SERVER_PASSWORD=change-me-too

# Safer default. Keep true unless you really want model tool access.
DISABLE_TOOLS=true

# External tool bridge is implemented by the proxy, not by OpenCode internal tools.
# Supported values today:
# - OPENCODE_EXTERNAL_TOOLS_MODE=proxy-bridge
# - OPENCODE_EXTERNAL_TOOLS_CONFLICT_POLICY=namespace
OPENCODE_EXTERNAL_TOOLS_MODE=proxy-bridge
OPENCODE_EXTERNAL_TOOLS_CONFLICT_POLICY=namespace

# Prompt handling. Left at the default on purpose: `plugin-inject` also flips
# OMIT_SYSTEM_PROMPT to true, which silently drops every system prompt the client sends,
# and the proxy then looks like it is ignoring instructions. Only switch to
# `plugin-inject` when running behind a client that manages prompts itself.
# OPENCODE_PROXY_PROMPT_MODE=standard
# OPENCODE_PROXY_OMIT_SYSTEM_PROMPT=false

# Conversation storage cleanup. Off by default because it is destructive: when enabled
# the proxy deletes message and session records older than CLEANUP_MAX_AGE_MS.
# OPENCODE_PROXY_AUTO_CLEANUP_CONVERSATIONS=false
# OPENCODE_PROXY_CLEANUP_INTERVAL_MS=43200000
# OPENCODE_PROXY_CLEANUP_MAX_AGE_MS=86400000

# External tool policy. Comma separated; accepts namespaced (external__foo) or original
# (foo) tool names. Denied calls are rejected, listed calls require confirmation.
# EXTERNAL_TOOL_POLICY_MODE=enforce
# EXTERNAL_TOOL_ALLOWLIST=
# EXTERNAL_TOOL_DENYLIST=
# EXTERNAL_TOOL_REQUIRE_CONFIRMATION_FOR=

# Optional overrides
# OPENCODE_PROXY_PORT=10000
# OPENCODE_SERVER_PORT=10001
# OPENCODE_USE_ISOLATED_HOME=false
# OPENCODE_PROXY_REQUEST_TIMEOUT_MS=180000
# OPENCODE_PROXY_DEBUG=false
# OPENCODE_ZEN_API_KEY=
# Model used when a request omits `model`. Falls back to the first model the backend
# reports, which is not guaranteed to be reachable.
# OPENCODE_DEFAULT_MODEL=
